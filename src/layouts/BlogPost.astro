---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import katex from 'katex';

function renderTocItem(text: string): string {
  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const parts: string[] = [];
  let i = 0;
  while (i < text.length) {
    const dollar = text.indexOf('$', i);
    if (dollar === -1) {
      parts.push(escapeHtml(text.slice(i)));
      break;
    }
    if (dollar > i) parts.push(escapeHtml(text.slice(i, dollar)));
    const end = text.indexOf('$', dollar + 1);
    if (end === -1) {
      parts.push(escapeHtml(text.slice(dollar)));
      break;
    }
    const expr = text.slice(dollar + 1, end);
    try {
      parts.push(katex.renderToString(expr, { throwOnError: false, output: 'html' }));
    } catch {
      parts.push(escapeHtml(text.slice(dollar, end + 1)));
    }
    i = end + 1;
  }
  return parts.join('');
}

export interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  body?: string;
  seriesNav?: {
    series: string;
    prev?: { slug: string; title: string };
    next?: { slug: string; title: string };
  };
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { title, description, pubDate, updatedDate, category = '未分类', tags = [], headings = [], body = '', seriesNav } = Astro.props;

function formatCN(date: Date): string {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

const formattedDate = pubDate ? formatCN(pubDate) : null;
const formattedUpdated = updatedDate ? formatCN(updatedDate) : null;

const plainBody = body
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/`[^`]*`/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
  .replace(/\[[^\]]*\]\([^)]+\)/g, ' ')
  .replace(/[#>*_\-\[\]()`~|]/g, ' ');
const chineseCount = (plainBody.match(/[一-鿿]/g) || []).length;
const wordLikeCount = (plainBody.match(/[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*/g) || []).length;
const totalWordCount = chineseCount + wordLikeCount;
const displayWordCount = totalWordCount.toLocaleString('zh-CN');
const readMinutes = Math.max(1, Math.ceil(totalWordCount / 420));
const wordCount = `${displayWordCount} 字`;
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={title} description={description} pubDate={pubDate}>
  <Header />

  {/* 滚动阅读时出现的固定迷你进度条（默认隐藏，原进度条滚出视口后显示） */}
  <div id="reading-progress-fixed" aria-hidden="true">
    <div class="border-b border-line bg-paper/92 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center gap-4 px-6 py-2">
        <span id="fixed-progress-label" class="whitespace-nowrap font-mono text-[11px] tabular-nums text-ink-faint"
          data-i18n-tpl="progress.label" data-n="0"
          >阅读进度 0%</span
        >
        <div class="h-[3px] flex-1 overflow-hidden rounded-full bg-line/60">
          <div id="fixed-progress-bar" class="h-full w-0 rounded-full bg-ember transition-[width] duration-150"></div>
        </div>
        <span id="fixed-remaining-label" class="whitespace-nowrap text-[11px] text-ink-ghost" data-i18n="progress.continue">继续阅读</span>
      </div>
    </div>
  </div>

  <main class="mx-auto w-full max-w-5xl flex-1 px-6">
    <div class:list={['grid gap-10 pb-16 pt-10', tocItems.length > 0 && 'lg:grid-cols-[200px_minmax(0,1fr)]']}>
      <!-- 目录：无章节时整栏不渲染，正文占满 -->
      {tocItems.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-ghost" data-i18n="post.toc">目录</h2>
          <nav class="mt-4 space-y-1 border-l border-line" aria-label="文章目录">
            {tocItems.map((item, index) => (
              <a
                href={`#${item.slug}`}
                data-toc-link
                data-toc-target={item.slug}
                class:list={[
                  '-ml-px block border-l-2 border-transparent pl-4 leading-6 text-ink-faint transition-colors hover:text-ink',
                  'text-[13px]',
                  item.depth === 3 && 'pl-7',
                  index === 0 && 'border-ember/70 text-ember',
                ]}
                set:html={renderTocItem(item.text)}
              />
            ))}
          </nav>
        </div>
      </aside>
      )}

      <div class="min-w-0">
        <!-- 文章头 -->
        <header>
          <a href="/blog" class="text-[13px] text-ink-faint transition-colors hover:text-ember">
            <span aria-hidden="true">←</span> <span data-i18n="post.allPosts">全部文章</span>
          </a>

          <div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[13px]">
            <a
              href={`/categories/${encodeURIComponent(category)}`}
              class="text-ember transition-colors hover:text-ember-deep"
            >
              {category}
            </a>
            {tags.map((tag) => (
              <span class="text-ink-ghost">
                <span class="mr-3 text-line-strong" aria-hidden="true">·</span>{tag}
              </span>
            ))}
          </div>

          <h1 class="mt-4 font-serif text-[32px] font-bold leading-[1.32] text-ink md:text-[40px]">
            {title}
          </h1>

          {description && (
            <p class="mt-4 max-w-2xl font-kai text-[17px] leading-8 text-ink-faint">{description}</p>
          )}

          <div
            class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[13px] tabular-nums text-ink-ghost"
          >
            {formattedDate && <time datetime={pubDate?.toISOString()}>{formattedDate}</time>}
            {formattedUpdated && <span><span data-i18n="post.updated">更新于</span> {formattedUpdated}</span>}
            <span data-i18n-tpl="post.words" data-n={displayWordCount}>{wordCount}</span>
            <span data-i18n-tpl="post.readMinutes" data-n={readMinutes}>约 {readMinutes} 分钟</span>
          </div>
        </header>

        {/* 文内阅读进度条（滚出视口后由固定迷你条接管） */}
        <div id="article-progress-summary" class="mt-8">
          <div class="h-[3px] overflow-hidden rounded-full bg-line/60">
            <div id="reading-progress-bar" class="h-full w-0 rounded-full bg-ember transition-[width] duration-150"></div>
          </div>
          <div class="mt-2 flex items-center justify-between font-mono text-[11px] tabular-nums text-ink-ghost">
            <span id="reading-progress-label" data-i18n-tpl="progress.label" data-n="0">阅读进度 0%</span>
            <span id="reading-remaining-label" data-i18n="progress.continue">继续阅读</span>
          </div>
        </div>

        <!-- 正文 -->
        <article class="mt-8">
          <div
            id="article-content"
            data-total-words={totalWordCount}
            class="article-prose prose prose-lg max-w-none prose-headings:scroll-mt-24 prose-strong:text-ink prose-code:before:content-[''] prose-code:after:content-['']"
          >
            <slot />
          </div>
        </article>

        {/* 系列内上一篇 / 下一篇 */}
        {seriesNav && (
          <nav class="mt-14 border-t border-line pt-8" aria-label="系列导航">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-ghost">
              <span data-i18n="series.nav">专栏</span> · {seriesNav.series}
            </p>
            <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
              {seriesNav.prev ? (
                <a href={`/blog/${seriesNav.prev.slug}`} class="group max-w-[46%]">
                  <span class="block text-[13px] text-ink-ghost" data-i18n="post.prev">上一篇</span>
                  <span class="mt-1 block text-[15px] font-medium text-ink transition-colors group-hover:text-ember">
                    {seriesNav.prev.title}
                  </span>
                </a>
              ) : <span />}
              {seriesNav.next ? (
                <a href={`/blog/${seriesNav.next.slug}`} class="group max-w-[46%] text-right">
                  <span class="block text-[13px] text-ink-ghost" data-i18n="post.next">下一篇</span>
                  <span class="mt-1 block text-[15px] font-medium text-ink transition-colors group-hover:text-ember">
                    {seriesNav.next.title}
                  </span>
                </a>
              ) : <span />}
            </div>
          </nav>
        )}

        {/* 文末签名档 */}
        <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
          <div class="flex items-center gap-4">
            <img
              src="/avatar.webp"
              alt="ArvelVale 的头像"
              class="h-12 w-12 rounded-full object-cover ring-1 ring-line-strong"
            />
            <div>
              <p class="text-[15px] font-medium text-ink">ArvelVale</p>
              <p class="mt-0.5 text-[13px] text-ink-faint" data-i18n="home.tagline">写代码，也写点别的</p>
            </div>
          </div>
          <a
            href="https://github.com/arvelvale"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-ember transition-colors hover:text-ember-deep"
          >
            GitHub <span aria-hidden="true">→</span>
          </a>
        </footer>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { t } from '../scripts/i18n';

  const articleContent = document.getElementById('article-content');
  const progressBar = document.getElementById('reading-progress-bar');
  const progressLabel = document.getElementById('reading-progress-label');
  const remainingLabel = document.getElementById('reading-remaining-label');
  const fixedProgress = document.getElementById('reading-progress-fixed');
  const fixedProgressBar = document.getElementById('fixed-progress-bar');
  const fixedProgressLabel = document.getElementById('fixed-progress-label');
  const fixedRemainingLabel = document.getElementById('fixed-remaining-label');
  const progressSummary = document.getElementById('article-progress-summary');
  const siteHeader = document.querySelector('header');
  const totalWords = Number(articleContent?.dataset.totalWords || 0);

  async function renderMindmapBlocks() {
    if (!(articleContent instanceof HTMLElement)) return;

    // Shiki 不认识 mindmap，靠 astro.config.mjs 的 langAlias 把语言标记保留在
    // pre[data-language] 上。注意不能用 code.language-mindmap —— Shiki 的输出里
    // <code> 上没有语言类。
    const blocks = Array.from(
      articleContent.querySelectorAll('pre[data-language="mindmap"]'),
    );
    if (blocks.length === 0) return;

    const { renderMindmap } = await import('../scripts/mindmap');
    const mounted: Array<{ host: HTMLElement; source: string }> = [];

    blocks.forEach((pre) => {
      if (!(pre instanceof HTMLPreElement)) return;
      const code = pre.querySelector(':scope > code');
      const source = code?.textContent || '';

      const frame = document.createElement('div');
      frame.className = 'mindmap-frame';
      pre.replaceWith(frame);

      renderMindmap(frame, source);
      mounted.push({ host: frame, source });
    });

    // 视口变化会改变单侧／双侧布局和画布宽度，防抖后整张重画
    let timer = 0;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        mounted.forEach(({ host, source }) => renderMindmap(host, source));
      }, 200);
    });
  }

  async function renderMermaidBlocks() {
    if (!(articleContent instanceof HTMLElement)) return;

    const blocks = articleContent.querySelectorAll('pre[data-language="mermaid"]');
    blocks.forEach((pre) => {
      if (!(pre instanceof HTMLPreElement)) return;
      const code = pre.querySelector(':scope > code');

      const diagram = document.createElement('div');
      diagram.className = 'mermaid';
      diagram.textContent = code?.textContent || '';

      const frame = document.createElement('div');
      frame.className = 'mermaid-diagram';
      frame.appendChild(diagram);

      pre.replaceWith(frame);
    });

    if (blocks.length === 0) return;

    try {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'default',
      });
      await mermaid.run({ querySelector: '#article-content .mermaid' });
    } catch (err) {
      console.error('Mermaid render failed:', err);
    }
  }

  function getCodeLanguage(code) {
    if (!(code instanceof HTMLElement)) return 'Plain Text';

    const languageClass = Array.from(code.classList).find((className) => className.startsWith('language-'));
    const language = languageClass?.replace('language-', '').trim();

    if (!language || language === 'text' || language === 'txt' || language === 'plaintext') return 'Plain Text';
    return language;
  }

  function enhanceCodeBlocks() {
    if (!(articleContent instanceof HTMLElement)) return;

    const blocks = articleContent.querySelectorAll('pre');
    blocks.forEach((pre) => {
      if (!(pre instanceof HTMLPreElement)) return;
      if (pre.dataset.enhanced === 'true') return;

      const code = pre.querySelector(':scope > code');
      if (!(code instanceof HTMLElement)) return;

      const language = getCodeLanguage(code);
      const isPlainText = language === 'Plain Text';
      pre.dataset.enhanced = 'true';
      pre.dataset.language = language;
      if (isPlainText) pre.classList.add('is-plain-code');

      const toolbar = document.createElement('div');
      toolbar.className = 'code-block-toolbar';

      const label = document.createElement('span');
      label.className = 'code-block-language';
      label.textContent = language;

      const copyButton = document.createElement('button');
      copyButton.className = 'code-copy-button';
      copyButton.type = 'button';
      copyButton.setAttribute('aria-label', t('copy.copy'));
      copyButton.innerHTML = `
        <svg viewBox="0 0 24 24" aria-hidden="true" class="code-copy-icon">
          <rect x="9" y="9" width="11" height="11" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>${t('copy.copy')}</span>
      `;

      copyButton.addEventListener('click', async () => {
        const text = code.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          copyButton.classList.add('is-copied');
          copyButton.querySelector('span').textContent = t('copy.copied');
          window.setTimeout(() => {
            copyButton.classList.remove('is-copied');
            copyButton.querySelector('span').textContent = t('copy.copy');
          }, 1600);
        } catch (err) {
          console.error('Copy code failed:', err);
          copyButton.querySelector('span').textContent = t('copy.fail');
          window.setTimeout(() => {
            copyButton.querySelector('span').textContent = t('copy.copy');
          }, 1600);
        }
      });

      toolbar.append(label, copyButton);
      pre.prepend(toolbar);
    });
  }

  function updateReadingProgress() {
    if (!(articleContent instanceof HTMLElement)) return;
    if (!(progressBar instanceof HTMLElement)) return;
    if (!(progressLabel instanceof HTMLElement)) return;
    if (!(remainingLabel instanceof HTMLElement)) return;

    const rect = articleContent.getBoundingClientRect();
    const viewportHeight = window.innerHeight;
    const totalScrollable = Math.max(articleContent.offsetHeight - viewportHeight * 0.35, 1);
    const progressed = Math.min(Math.max(viewportHeight * 0.65 - rect.top, 0), totalScrollable);
    const percent = Math.min(100, Math.max(0, Math.round((progressed / totalScrollable) * 100)));

    progressBar.style.width = `${percent}%`;
    progressLabel.textContent = t('progress.label', { n: percent });

    const remaining = totalWords > 0
      ? Math.max(1, Math.ceil((totalWords * (100 - percent)) / 42000))
      : Math.max(1, Math.ceil(((100 - percent) / 100) * 5));
    const remainingText = percent >= 96 ? t('progress.almost') : t('progress.remaining', { n: remaining });
    remainingLabel.textContent = remainingText;

    // 固定迷你进度条与原进度条同步更新
    if (fixedProgressBar instanceof HTMLElement) fixedProgressBar.style.width = `${percent}%`;
    if (fixedProgressLabel instanceof HTMLElement) fixedProgressLabel.textContent = t('progress.label', { n: percent });
    if (fixedRemainingLabel instanceof HTMLElement) fixedRemainingLabel.textContent = remainingText;
  }

  window.addEventListener('langchange', updateReadingProgress);

  // 固定条贴在站点 Header 正下方，Header 高度随响应式变化，需动态测量
  function positionFixedProgress() {
    if (!(fixedProgress instanceof HTMLElement)) return;
    const headerHeight = siteHeader instanceof HTMLElement ? siteHeader.offsetHeight : 0;
    fixedProgress.style.top = `${headerHeight}px`;
  }

  // 原进度条滚出视口后才显示固定条；滚回顶部时隐藏
  if (fixedProgress instanceof HTMLElement && progressSummary instanceof HTMLElement) {
    const progressObserver = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        fixedProgress.classList.toggle('is-visible', show);
      },
      { threshold: 0 },
    );
    progressObserver.observe(progressSummary);
  }

  // 目录 scrollspy：滚动时高亮当前章节
  function setupTocScrollspy() {
    const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (tocLinks.length === 0) return;

    const linkById = new Map<string, Element>();
    tocLinks.forEach((link) => {
      const id = (link as HTMLElement).dataset.tocTarget;
      if (id) linkById.set(id, link);
    });

    const headingEls = Array.from(linkById.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headingEls.length === 0) return;

    const activate = (id: string) => {
      tocLinks.forEach((link) => link.classList.remove('border-ember/70', 'text-ember'));
      const active = linkById.get(id);
      if (active) active.classList.add('border-ember/70', 'text-ember');
    };

    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) activate(entry.target.id);
        }
      },
      // 标题进入「Header 下方 ~ 视口上 1/3」的带区时点亮
      { rootMargin: '-80px 0px -66% 0px', threshold: 0 },
    );
    headingEls.forEach((el) => spy.observe(el));
  }

  renderMindmapBlocks()
    .then(renderMermaidBlocks)
    .then(enhanceCodeBlocks);
  positionFixedProgress();
  updateReadingProgress();
  setupTocScrollspy();
  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  window.addEventListener('resize', () => {
    positionFixedProgress();
    updateReadingProgress();
  });
</script>

<style>
  /* 固定迷你阅读进度条：默认从 Header 后面滑入，仅当原进度条滚出视口时显示 */
  #reading-progress-fixed {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 40;
    transform: translateY(-120%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  #reading-progress-fixed.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  /* ── 正文排版：LXGW WenKai 阅读体验 + 墨色纸面 ───────────────────────── */

  .article-prose {
    font-family: 'LXGW WenKai Screen', 'Noto Serif SC', 'Songti SC', 'STSong', serif;
    font-size: 1.05rem;
    line-height: 1.85;
    letter-spacing: 0.015em;
    color: #4a4237;
  }

  .article-prose :global(p) {
    margin-top: 0.9rem;
    margin-bottom: 0.9rem;
    line-height: 1.85;
  }

  .article-prose :global(li) {
    margin-top: 0.32rem;
    margin-bottom: 0.32rem;
    line-height: 1.8;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-top: 0.82rem;
    margin-bottom: 0.82rem;
  }

  .article-prose :global(h2),
  .article-prose :global(h3),
  .article-prose :global(h4) {
    font-family: 'LXGW WenKai Screen', 'Noto Serif SC', 'Songti SC', serif;
    color: #2c2620;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  .article-prose :global(blockquote) {
    border-left: 2px solid #c04a1a;
    background: rgba(192, 74, 26, 0.04);
    border-radius: 0 6px 6px 0;
    padding: 0.35rem 1.1rem;
    font-style: normal;
  }

  .article-prose :global(blockquote p) {
    font-family: 'LXGW WenKai Screen', 'Noto Serif SC', 'Songti SC', serif;
    color: #5d5346;
    line-height: 1.7;
  }

  .article-prose :global(a) {
    color: #c04a1a;
    text-decoration: underline;
    text-decoration-color: rgba(192, 74, 26, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms ease;
  }

  .article-prose :global(a:hover) {
    text-decoration-color: #c04a1a;
  }

  .article-prose :global(img) {
    border-radius: 8px;
  }

  .article-prose :global(hr) {
    border-color: #e7dfcf;
  }

  /* 行内代码：安静的纸片，不再用橙色渐变药丸 */
  .article-prose :global(:not(pre) > code) {
    border: 1px solid rgba(192, 74, 26, 0.16);
    border-radius: 4px;
    background: rgba(192, 74, 26, 0.05);
    padding: 0.1rem 0.35rem;
    color: #9c3a12;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
    font-weight: 500;
  }

  /* 代码块 */
  .article-prose :global(pre) {
    position: relative;
    margin: 1.8rem 0;
    overflow: hidden;
    border: 1px solid #e0d6c2;
    border-radius: 10px;
    background: #f7f2e6;
  }

  .article-prose :global(.code-block-toolbar) {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    min-height: 2.45rem;
    border-bottom: 1px solid rgba(214, 202, 178, 0.6);
    background: rgba(247, 242, 230, 0.92);
    padding: 0.35rem 0.55rem 0.35rem 0.85rem;
    backdrop-filter: blur(10px);
  }

  .article-prose :global(.code-block-language) {
    border-radius: 4px;
    background: rgba(255, 253, 249, 0.85);
    color: #8b7f6d;
    padding: 0.3rem 0.55rem;
    font-family: 'JetBrains Mono', 'Noto Sans SC', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
  }

