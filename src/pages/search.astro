---
// 旧路径：跳到默认语言的搜索页，保留 query
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/en/search/" />
    <title>ArvelVale</title>
  </head>
  <body>
    <script is:inline>
      location.replace('/en/search/' + location.search + location.hash);
    </script>
  </body>
</html>
