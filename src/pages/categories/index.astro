---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categoryMap = posts.reduce((acc, post) => {
  const key = post.data.category || '未分类';
  if (!acc.has(key)) acc.set(key, []);
  acc.get(key)?.push(post);
  return acc;
}, new Map<string, typeof posts>());

const categories = Array.from(categoryMap.entries()).sort((a, b) => {
  if (a[0] === '未分类') return 1;
  if (b[0] === '未分类') return -1;
  return a[0].localeCompare(b[0], 'zh-CN');
});
---

<BaseLayout title="分类" description="按分类浏览 Aerchen 的博客文章">
  <Header />

  <main class="mx-auto w-full max-w-3xl flex-1 px-6">
    <section class="pt-14 md:pt-20">
      <h1 class="font-serif text-4xl font-bold text-ink">分类</h1>
      <p class="mt-4 max-w-xl text-[15px] leading-7 text-ink-faint">
        把技术探索按主题整理成更清晰的知识分区。分类不是为了把内容关进盒子，而是为了更快找到下一条值得深入的线索。
      </p>
    </section>

    <ul class="divide-y divide-line/70 pb-20 pt-6">
      {categories.map(([category, items]) => (
        <li>
          <a
            href={`/categories/${encodeURIComponent(category)}`}
            class="group flex items-baseline justify-between gap-6 py-5"
          >
            <div class="min-w-0">
              <h2 class="text-lg font-medium text-ink transition-colors group-hover:text-ember">
                {category}
              </h2>
              <p class="mt-1 line-clamp-1 text-sm text-ink-faint">
                最近：<span class="font-kai">{items[0]?.data.title}</span>
              </p>
            </div>
            <span class="shrink-0 font-mono text-sm tabular-nums text-ink-ghost">{items.length} 篇</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</BaseLayout>
