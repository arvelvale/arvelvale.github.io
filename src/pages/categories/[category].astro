---
// 旧分类路径：跳到默认语言版本
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = Array.from(new Set(posts.map((post) => post.data.category || '未分类')));
  return categories.map((category) => ({ params: { category } }));
}

const target = `/en/categories/${encodeURIComponent(Astro.params.category)}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>ArvelVale</title>
  </head>
  <body>
    <script is:inline>
      location.replace('/en' + location.pathname + location.search + location.hash);
    </script>
  </body>
</html>
