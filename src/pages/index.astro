---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = posts.slice(0, 8);
const postCount = posts.length;

const categoryMap = posts.reduce((acc, post) => {
  const key = post.data.category || '未分类';
  acc.set(key, (acc.get(key) || 0) + 1);
  return acc;
}, new Map<string, number>());
const categories = Array.from(categoryMap.entries()).sort((a, b) => b[1] - a[1]);
const categoryCount = categories.length;

const tagMap = posts.reduce((acc, post) => {
  for (const tag of post.data.tags) {
    acc.set(tag, (acc.get(tag) || 0) + 1);
  }
  return acc;
}, new Map<string, number>());
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
const tagCount = tags.length;

function formatDot(date: Date): string {
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${date.getFullYear()}.${m}.${d}`;
}
---

<BaseLayout title="首页" description="Thoughts on AI, Building, Markets, and Life.">
  <Header />

  <main class="mx-auto w-full max-w-5xl flex-1 px-6">
    <!-- 开场：头像 + 名字 + 一句自我介绍 -->
    <section class="pb-14 pt-14 md:pt-20">
      <div class="flex items-center gap-5">
        <img
          src="/头像.png"
          alt="ArvelVale 的头像"
          class="h-16 w-16 rounded-full object-cover ring-1 ring-line-strong md:h-[72px] md:w-[72px]"
        />
        <div>
          <h1 class="font-serif text-4xl font-bold leading-tight text-ink md:text-[42px]">
            ArvelVale<span class="ml-2 align-middle text-xl text-ember" aria-hidden="true">✦</span>
          </h1>
          <p class="mt-1.5 text-[15px] text-ink-faint">写代码，也写点别的</p>
        </div>
      </div>

      <p class="mt-7 max-w-xl font-kai text-[17px] leading-8 text-ink-soft">
        这里记我在 AI、软件构建和别的事情上想过的问题。
      </p>
      <p class="mt-3 font-mono text-[13px] tracking-wide text-ink-ghost">
        Thoughts on AI, Building, Markets, and Life.
      </p>

      <p class="mt-6 text-sm text-ink-faint">
        <span class="font-medium tabular-nums text-ink">{postCount}</span> 篇文章
        <span class="mx-1.5 text-line-strong">·</span>
        <span class="font-medium tabular-nums text-ink">{categoryCount}</span> 个分类
        <span class="mx-1.5 text-line-strong">·</span>
        <span class="font-medium tabular-nums text-ink">{tagCount}</span> 个标签
      </p>
    </section>

    <div class="grid gap-12 pb-16 lg:grid-cols-[minmax(0,1fr)_230px] lg:gap-14">
      <!-- 最近写作：列表式索引 -->
      <section aria-labelledby="recent-heading">
        <div class="flex items-center gap-4">
          <h2 id="recent-heading" class="shrink-0 font-serif text-xl font-bold text-ink">最近写作</h2>
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
          <a href="/blog" class="group shrink-0 text-[13px] text-ink-faint transition-colors hover:text-ember">
            全部文章
            <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <ul class="mt-3 divide-y divide-line/70">
          {featuredPosts.map((post) => {
            const readingMinutes = Math.max(1, Math.ceil((post.body?.length || 800) / 420));
            return (
              <li>
                <a href={`/blog/${post.id}`} class="group block py-4 sm:flex sm:items-baseline sm:gap-6">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="block font-mono text-[13px] tabular-nums text-ink-ghost sm:w-[88px] sm:shrink-0"
                  >
                    {formatDot(post.data.pubDate)}
                  </time>
                  <div class="mt-1 min-w-0 sm:mt-0">
                    <h3 class="text-[17px] font-medium leading-snug text-ink transition-colors group-hover:text-ember">
                      {post.data.title}
                    </h3>
                    {post.data.description && (
                      <p class="mt-1 line-clamp-1 text-sm leading-6 text-ink-faint">{post.data.description}</p>
                    )}
                    <p class="mt-1.5 text-xs text-ink-ghost">
                      {post.data.category}
                      <span class="mx-1 text-line-strong">·</span>
                      约 {readingMinutes} 分钟
                    </p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>

      <!-- 侧栏：分类 + 标签 -->
      <aside class="space-y-10">
        <section aria-labelledby="aside-categories">
          <h2
            id="aside-categories"
            class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-ghost"
          >
            分类
          </h2>
          <ul class="mt-4 space-y-2.5">
            {categories.slice(0, 7).map(([name, count]) => (
              <li>
                <a
                  href={`/categories/${encodeURIComponent(name)}`}
                  class="group flex items-baseline justify-between gap-3 text-[14px]"
                >
                  <span class="text-ink-soft transition-colors group-hover:text-ember">{name}</span>
                  <span class="font-mono text-xs tabular-nums text-ink-ghost">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section id="tags" aria-labelledby="aside-tags">
          <h2 id="aside-tags" class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-ghost">
            标签
          </h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map(({ name }) => (
              <a
                href={`/search?q=${encodeURIComponent(name)}`}
                class="rounded border border-line px-2 py-0.5 text-xs text-ink-faint transition-colors hover:border-ember/40 hover:text-ember"
              >
                {name}
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>

    <!-- 关于 -->
    <section id="about" aria-labelledby="about-heading" class="border-t border-line pb-20 pt-12">
      <h2 id="about-heading" class="font-serif text-xl font-bold text-ink">关于</h2>
      <p class="mt-4 max-w-2xl font-kai text-[15.5px] leading-8 text-ink-soft">
        我是 ArvelVale，做开发的，最近在学 AI 和软件设计。这里放学习笔记、项目记录，偶尔有些读书笔记和想法。更新不勤，但每篇都是自己想过一遍的。
      </p>
      <a
        href="https://github.com/arvelvale"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-1.5 text-sm text-ember transition-colors hover:text-ember-deep"
      >
        GitHub
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>
