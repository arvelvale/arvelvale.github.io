---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Lang } from '../../scripts/i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;

// 只读 diary 集合：不经过 blog 集合，因此与分类 / 专栏体系完全隔离
const entries = (await getCollection('diary'))
  .filter((entry) => (entry.data.lang ?? 'zh') === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const entriesByYear = new Map<number, typeof entries>();
for (const entry of entries) {
  const year = entry.data.pubDate.getFullYear();
  if (!entriesByYear.has(year)) entriesByYear.set(year, []);
  entriesByYear.get(year)?.push(entry);
}
const years = Array.from(entriesByYear.keys()).sort((a, b) => b - a);

function formatDot(date: Date): string {
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${date.getFullYear()}.${m}.${d}`;
}
---

<BaseLayout title="日记" titleKey="diary.title" description={t(lang, 'diary.intro')}>
  <Header />

  <main class="mx-auto w-full max-w-3xl flex-1 px-6">
    <section class="pb-4 pt-14 md:pt-20">
      <h1 class="font-serif text-4xl font-bold text-ink">{t(lang, 'diary.title')}</h1>
      <p class="mt-4 max-w-xl text-[15px] leading-7 text-ink-faint">
        {t(lang, 'diary.intro')}
        {entries.length > 0 && <> <span class="tabular-nums text-ink">{t(lang, entries.length === 1 ? 'diary.count.one' : 'diary.count.many', { n: entries.length })}</span></>}
      </p>
    </section>

    <div class="pb-20">
      {years.map((year) => (
        <section class="mt-10 first:mt-8" aria-labelledby={`diary-year-${year}`}>
          <div class="flex items-center gap-4">
            <h2 id={`diary-year-${year}`} class="shrink-0 font-mono text-sm tabular-nums tracking-[0.12em] text-ink-ghost">{year}</h2>
            <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
          </div>
          <ul class="mt-2 divide-y divide-line/70">
            {entriesByYear.get(year)?.map((entry) => {
              const readingMinutes = Math.max(1, Math.ceil((entry.body?.length || 800) / 420));
              return (
                <li>
                  <a href={getRelativeLocaleUrl(lang, `/diary/${entry.id}`)} class="group block py-4 sm:flex sm:items-baseline sm:gap-6">
                    <time
                      datetime={entry.data.pubDate.toISOString()}
                      class="block font-mono text-[13px] tabular-nums text-ink-ghost sm:w-[88px] sm:shrink-0"
                    >
                      {formatDot(entry.data.pubDate)}
                    </time>
                    <div class="mt-1 min-w-0 sm:mt-0">
                      <h3 class="text-[17px] font-medium leading-snug text-ink transition-colors group-hover:text-ember">
                        {entry.data.title}
                      </h3>
                      {entry.data.description && (
                        <p class="mt-1 line-clamp-1 text-sm leading-6 text-ink-faint">{entry.data.description}</p>
                      )}
                      <p class="mt-1.5 text-xs text-ink-ghost">{t(lang, 'post.readMinutes', { n: readingMinutes })}</p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      {entries.length === 0 && (
        <p class="py-16 text-center text-ink-faint">{t(lang, 'diary.empty')}</p>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>
