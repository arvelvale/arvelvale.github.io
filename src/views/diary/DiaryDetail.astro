---
import { coverSeed } from '../../scripts/projects';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BlogPost from '../../layouts/BlogPost.astro';
import { t } from '../../scripts/i18n';

type Props = CollectionEntry<'diary'>;

const entry = Astro.props;
const { Content, headings } = await entry.render();

// 与 PostDetail 一致：从原文补回标题里的行内公式/标记，避免目录显示被清理过的文本
const rawHeadings: Array<{ depth: number; text: string }> = [];
const lines = entry.body.split('\n');
let inFence = false;
for (const line of lines) {
  if (/^\s*```/.test(line)) {
    inFence = !inFence;
    continue;
  }
  if (inFence) continue;
  const m = /^(#{1,6})\s+(.*?)\s*#*\s*$/.exec(line);
  if (m) rawHeadings.push({ depth: m[1].length, text: m[2] });
}

const enrichedHeadings = headings.map((h) => {
  const idx = rawHeadings.findIndex((r) => r.depth === h.depth);
  if (idx >= 0) {
    const raw = rawHeadings.splice(idx, 1)[0];
    return { ...h, text: raw.text };
  }
  return h;
});

const entryLang = entry.data.lang ?? 'zh';
const otherLang = entryLang === 'en' ? 'zh' : 'en';
const translation = entry.data.translationSlug
  ? (await getCollection('diary')).find((item) => item.id === entry.data.translationSlug && item.data.lang === otherLang)
  : undefined;
const translationHref = translation
  ? getRelativeLocaleUrl(otherLang, `/diary/${translation.id}/`)
  : undefined;

const originalLang = entry.data.originalLang ?? entryLang;
const translationNote =
  originalLang !== entryLang
    ? t(entryLang, originalLang === 'zh' ? 'post.note.aiFromZh' : 'post.note.aiFromEn')
    : undefined;
---

<BlogPost
  kind="diary"
  title={entry.data.title}
  description={entry.data.description}
  cover={entry.data.cover}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  headings={enrichedHeadings}
  body={entry.body}
  translationHref={translationHref}
  translationNote={translationNote}
  coverSeed={coverSeed(entry.id, entry.data.translationSlug)}
>
  <Content />
</BlogPost>
