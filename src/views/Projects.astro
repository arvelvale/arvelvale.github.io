---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../scripts/i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;

const projects = [
  {
    name: 'Humanindex',
    url: 'https://humanindex.fun',
    domain: 'humanindex.fun',
    descKey: 'projects.humanindex.desc',
  },
  {
    name: lang === 'zh' ? '喵灵 MindOff' : 'MindOff',
    url: 'https://yingjiapp.com',
    domain: 'yingjiapp.com',
    descKey: 'projects.mindoff.desc',
  },
];
---

<BaseLayout title={t(lang, 'projects.title')} titleKey="projects.title" description={t(lang, 'projects.intro')}>
  <Header />

  <main class="mx-auto w-full max-w-3xl flex-1 px-6">
    <section class="pt-14 md:pt-20">
      <h1 class="font-serif text-4xl font-bold text-ink">{t(lang, 'projects.title')}</h1>
      <p class="mt-4 max-w-xl text-[15px] leading-7 text-ink-faint">
        {t(lang, 'projects.intro')}
      </p>
    </section>

    <ul class="space-y-5 pb-16 pt-10">
      {projects.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-lg border border-line bg-raised p-6 transition-colors hover:border-ember/50"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-serif text-xl font-bold text-ink transition-colors group-hover:text-ember">
                {p.name}
              </h2>
              <span class="shrink-0 font-mono text-[13px] text-ink-ghost">
                {p.domain} <span aria-hidden="true">→</span>
              </span>
            </div>
            <p class="mt-2 text-[15px] leading-7 text-ink-faint">{t(lang, p.descKey)}</p>
          </a>
        </li>
      ))}
    </ul>

    <section class="border-t border-line pb-20 pt-10">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-ghost">
        {t(lang, 'projects.elsewhere')}
      </h2>
      <div class="mt-4 flex flex-wrap gap-3 text-[15px]">
        <a
          href="https://x.com/Arvelvale"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-line px-3 py-1.5 text-ink-soft transition-colors hover:border-ember/50 hover:text-ember"
        >
          {t(lang, 'projects.twitter')} · @Arvelvale
        </a>
        <a
          href="https://github.com/arvelvale"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-line px-3 py-1.5 text-ink-soft transition-colors hover:border-ember/50 hover:text-ember"
        >
          GitHub · @arvelvale
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
