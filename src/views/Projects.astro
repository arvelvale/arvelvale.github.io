---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../scripts/i18n';
import { getProjects } from '../scripts/projects';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const projects = getProjects(lang);
---

<BaseLayout title={t(lang, 'projects.title')} titleKey="projects.title" description={t(lang, 'projects.intro')}>
  <Header />

  <main class="mx-auto w-full max-w-6xl flex-1 px-6">
    <section class="pt-14 md:pt-20">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ember">PROJECTS · {String(projects.length).padStart(2, '0')}</p>
      <h1 class="mt-3 font-serif text-5xl font-black leading-none text-ink md:text-7xl">{t(lang, 'projects.title')}</h1>
      <p class="mt-5 max-w-xl text-[15px] leading-7 text-ink-soft">{t(lang, 'projects.intro')}</p>
    </section>

    <ul class="grid gap-5 pb-16 pt-10 md:grid-cols-2">
      {projects.map((p, i) => (
        <li class:list={[i === 0 && 'md:col-span-2']}>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card-lift group flex h-full flex-col rounded-lg border border-line bg-raised p-7"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-center gap-4">
                <img src={p.logo} alt={p.name + ' logo'} width="64" height="64" loading="lazy" class="h-16 w-16 rounded-2xl object-cover ring-1 ring-line-strong" />
                <span class="font-serif text-3xl font-black leading-none text-line-strong transition-colors group-hover:text-ember/70">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-faint">
                {p.category} · {p.year}
              </span>
            </div>
            <h2 class="mt-6 font-serif text-2xl font-bold text-ink transition-colors group-hover:text-ember">{p.name}</h2>
            <p class="mt-3 max-w-2xl text-[15px] leading-7 text-ink-soft">{p.desc}</p>
            <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-6">
              <ul class="flex flex-wrap gap-1.5">
                {p.stack.map((s) => (
                  <li class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-ink-faint">{s}</li>
                ))}
              </ul>
              <span class="font-mono text-[13px] text-ink-faint transition-colors group-hover:text-ember">
                {p.domain} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <section class="border-t border-line pb-20 pt-10">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint">{t(lang, 'projects.elsewhere')}</h2>
      <div class="mt-4 flex flex-wrap gap-3 text-[15px]">
        <a
          href="https://x.com/Arvelvale"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-line px-3 py-1.5 text-ink-soft transition-colors hover:border-ember/50 hover:text-ember"
        >
          {t(lang, 'projects.twitter')} · @Arvelvale
        </a>
        <a
          href="https://github.com/arvelvale"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-line px-3 py-1.5 text-ink-soft transition-colors hover:border-ember/50 hover:text-ember"
        >
          GitHub · @arvelvale
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
