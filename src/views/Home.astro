---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Lang } from '../scripts/i18n';
import { getProjects } from '../scripts/projects';

const lang = (Astro.currentLocale ?? 'en') as Lang;

const posts = (await getCollection('blog'))
  .filter((post) => (post.data.lang ?? 'zh') === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = posts.slice(0, 3);
const morePosts = posts.slice(3, 9);
const projects = getProjects(lang);
const latest = posts[0]?.data.pubDate;
const minutes = (p: (typeof posts)[number]) => Math.max(1, Math.ceil((p.body?.length || 800) / 420));
const postCount = posts.length;

const categoryMap = posts.reduce((acc, post) => {
  const key = post.data.category || '未分类';
  acc.set(key, (acc.get(key) || 0) + 1);
  return acc;
}, new Map<string, number>());
const categories = Array.from(categoryMap.entries()).sort((a, b) => b[1] - a[1]);
const categoryCount = categories.length;

const tagMap = posts.reduce((acc, post) => {
  for (const rawTag of post.data.tags) {
    // 与 blog-editor 的 normalizeTagName 对齐：去首尾空格、压缩连续空白，避免 " AI" 与 "AI" 分裂成两个标签
    const tag = String(rawTag ?? '').trim().replace(/\s+/g, ' ');
    if (!tag) continue;
    acc.set(tag, (acc.get(tag) || 0) + 1);
  }
  return acc;
}, new Map<string, number>());
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
const tagCount = tags.length;

function formatDot(date: Date): string {
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${date.getFullYear()}.${m}.${d}`;
}
---

<BaseLayout title="首页" titleKey="nav.home" description="Thoughts on AI, Building, Markets, and Life.">
  <Header />

  <main class="flex-1">
    <!-- Hero：巨型名字 + 取景框头像 -->
    <section class="grid-paper border-b border-line">
      <div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 py-14 md:py-20 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-14">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ember">
            <span aria-hidden="true" class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember"></span>{t(lang, 'home.hero.eyebrow')}
          </p>
          <h1 class="mt-5 font-serif text-[clamp(56px,11vw,148px)] font-black leading-[0.95] tracking-tight text-ink">
            ArvelVale
          </h1>
          <p class="mt-7 max-w-lg font-kai text-lg leading-8 text-ink-soft">{t(lang, 'home.intro')}</p>
          <p class="mt-2 font-mono text-[13px] tracking-wide text-ink-faint">{t(lang, 'home.tagline')}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={getRelativeLocaleUrl(lang, '/blog')}
              class="rounded border border-ink bg-ink px-5 py-2.5 text-sm text-paper transition-colors hover:border-ember hover:bg-ember"
            >
              {t(lang, 'home.hero.readPosts')} →
            </a>
            <a
              href={getRelativeLocaleUrl(lang, '/projects')}
              class="rounded border border-ink px-5 py-2.5 text-sm text-ink transition-colors hover:border-ember hover:text-ember"
            >
              {t(lang, 'home.hero.seeProjects')} →
            </a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-sm">
          <div class="relative rounded-lg border border-line-strong bg-raised p-3 shadow-[0_18px_40px_rgba(44,38,32,0.08)]">
            <span aria-hidden="true" class="absolute -left-2 -top-2 h-4 w-4 border-l-2 border-t-2 border-ember"></span>
            <span aria-hidden="true" class="absolute -bottom-2 -right-2 h-4 w-4 border-b-2 border-r-2 border-ember"></span>
            <img src="/avatar.webp" alt="ArvelVale" class="aspect-square w-full rounded object-cover" />
            <div class="mt-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.16em] text-ink-faint">
              <span>{t(lang, 'home.hero.subject')} // ARVELVALE</span>
              <span>DEV · AI · WRITING</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 信号条：三个大数字 -->
      <div class="border-t border-line bg-paper/70">
        <dl class="mx-auto grid w-full max-w-6xl grid-cols-2 gap-y-4 px-6 py-6 sm:grid-cols-4">
          <div>
            <dd class="font-serif text-3xl font-bold tabular-nums text-ink">{postCount}</dd>
            <dt class="mt-0.5 text-xs text-ink-faint">{t(lang, 'home.stats.posts')}</dt>
          </div>
          <div>
            <dd class="font-serif text-3xl font-bold tabular-nums text-ink">{categoryCount}</dd>
            <dt class="mt-0.5 text-xs text-ink-faint">{t(lang, 'home.stats.categories')}</dt>
          </div>
          <div>
            <dd class="font-serif text-3xl font-bold tabular-nums text-ink">{tagCount}</dd>
            <dt class="mt-0.5 text-xs text-ink-faint">{t(lang, 'home.stats.tags')}</dt>
          </div>
          <div>
            <dd class="font-mono text-base font-medium tabular-nums text-ink sm:pt-2">{latest ? formatDot(latest) : '—'}</dd>
            <dt class="mt-1 text-xs text-ink-faint">{t(lang, 'home.latestUpdate')}</dt>
          </div>
        </dl>
      </div>
    </section>

    <!-- 关键词走马灯 -->
    <div class="overflow-hidden border-b border-line bg-paper-deep py-3" aria-hidden="true">
      <div class="marquee-track font-mono text-[12px] uppercase tracking-[0.18em] text-ink-faint">
        {[0, 1].map(() => (
          <span class="shrink-0 whitespace-nowrap pr-12">{t(lang, 'home.marquee')} · </span>
        ))}
      </div>
    </div>

    <div class="mx-auto w-full max-w-6xl px-6">
      <!-- 精选：一大两小 -->
      <section class="reveal pt-16" aria-labelledby="featured-heading">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ember">01 / {t(lang, 'home.recent')}</p>
            <h2 id="featured-heading" class="mt-2 font-serif text-3xl font-bold text-ink md:text-4xl">{t(lang, 'home.featured')}</h2>
          </div>
          <a href={getRelativeLocaleUrl(lang, '/blog')} class="group shrink-0 text-[13px] text-ink-faint transition-colors hover:text-ember">
            {t(lang, 'home.allPosts')}
            <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2 md:grid-rows-2">
          {featuredPosts.map((post, i) => (
            <a
              href={getRelativeLocaleUrl(lang, `/blog/${post.id}`)}
              class:list={[
                'card-lift group flex flex-col overflow-hidden rounded-lg border border-line bg-raised',
                i === 0 && 'md:row-span-2',
              ]}
            >
              {post.data.cover && i === 0 && (
                <img src={post.data.cover} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" />
              )}
              <div class:list={['flex flex-1 flex-col p-6', i === 0 && 'md:p-8']}>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-faint">
                  {post.data.category} · {formatDot(post.data.pubDate)}
                </p>
                <h3
                  class:list={[
                    'mt-3 font-serif font-bold leading-snug text-ink transition-colors group-hover:text-ember',
                    i === 0 ? 'text-2xl md:text-3xl' : 'text-xl',
                  ]}
                >
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class:list={['mt-3 text-sm leading-7 text-ink-soft', i === 0 ? 'line-clamp-5' : 'line-clamp-3']}>
                    {post.data.description}
                  </p>
                )}
                <p class="mt-auto pt-5 font-mono text-xs text-ink-faint">
                  {t(lang, 'post.readMinutes', { n: minutes(post) })}
                  <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-0.5">→</span>
                </p>
              </div>
            </a>
          ))}
        </div>

        <ul class="mt-6 divide-y divide-line/70 border-t border-line/70">
          {morePosts.map((post) => (
            <li>
              <a href={getRelativeLocaleUrl(lang, `/blog/${post.id}`)} class="group flex items-baseline gap-5 py-3.5">
                <time datetime={post.data.pubDate.toISOString()} class="w-[88px] shrink-0 font-mono text-[13px] tabular-nums text-ink-faint">
                  {formatDot(post.data.pubDate)}
                </time>
                <span class="min-w-0 flex-1 truncate text-[16px] text-ink transition-colors group-hover:text-ember">{post.data.title}</span>
                <span class="hidden shrink-0 text-xs text-ink-faint sm:inline">{post.data.category}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- 作品预览 -->
      <section class="reveal pt-20" aria-labelledby="projects-heading">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ember">02 / {t(lang, 'home.projects')}</p>
            <h2 id="projects-heading" class="mt-2 font-serif text-3xl font-bold text-ink md:text-4xl">{t(lang, 'home.projects')}</h2>
          </div>
          <a href={getRelativeLocaleUrl(lang, '/projects')} class="group shrink-0 text-[13px] text-ink-faint transition-colors hover:text-ember">
            {t(lang, 'home.allProjects')}
            <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
        <ul class="mt-8 grid gap-5 md:grid-cols-3">
          {projects.map((p, i) => (
            <li>
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card-lift group flex h-full flex-col rounded-lg border border-line bg-raised p-6"
              >
                <span class="font-serif text-4xl font-black leading-none text-line-strong transition-colors group-hover:text-ember/70">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-faint">{p.category} · {p.year}</p>
                <h3 class="mt-2 font-serif text-xl font-bold text-ink transition-colors group-hover:text-ember">{p.name}</h3>
                <p class="mt-2 line-clamp-4 text-sm leading-7 text-ink-soft">{p.desc}</p>
                <p class="mt-auto pt-5 font-mono text-xs text-ink-faint">{p.domain} →</p>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- 分类 -->
      <section class="reveal pt-20" aria-labelledby="aside-categories">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ember">03 / {t(lang, 'home.categories')}</p>
        <h2 id="aside-categories" class="mt-2 font-serif text-3xl font-bold text-ink md:text-4xl">{t(lang, 'home.categories')}</h2>
        <div class="mt-8 flex flex-wrap gap-3">
          {categories.slice(0, 8).map(([name, count]) => (
            <a
              href={getRelativeLocaleUrl(lang, `/categories/${encodeURIComponent(name)}`)}
              class="card-lift group inline-flex items-baseline gap-2 rounded-full border border-line bg-raised px-5 py-2 text-[15px] text-ink-soft"
            >
              <span class="transition-colors group-hover:text-ember">{name}</span>
              <span class="font-mono text-xs tabular-nums text-ink-faint">{count}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- 关于 + 联系 -->
      <section id="about" aria-labelledby="about-heading" class="reveal mt-20 grid gap-8 border-t border-line pb-20 pt-14 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ember">04 / {t(lang, 'home.about')}</p>
          <h2 id="about-heading" class="mt-2 font-serif text-3xl font-bold text-ink md:text-4xl">{t(lang, 'home.about')}</h2>
        </div>
        <div>
          <p class="max-w-2xl font-kai text-[16px] leading-8 text-ink-soft">{t(lang, 'home.about.body')}</p>
          <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint">{t(lang, 'home.contact')}</p>
          <p class="mt-2 text-sm text-ink-soft">{t(lang, 'home.contact.lead')}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href="https://github.com/arvelvale"
              target="_blank"
              rel="noopener noreferrer"
              class="card-lift rounded-lg border border-line bg-raised px-5 py-3 text-sm text-ink-soft"
            >
              GitHub <span class="font-mono text-xs text-ink-faint">@arvelvale</span> →
            </a>
            <a
              href="https://x.com/Arvelvale"
              target="_blank"
              rel="noopener noreferrer"
              class="card-lift rounded-lg border border-line bg-raised px-5 py-3 text-sm text-ink-soft"
            >
              X <span class="font-mono text-xs text-ink-faint">@Arvelvale</span> →
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // 滚动入场：没有 IntersectionObserver 或用户要求减弱动效时直接显示，不隐藏任何内容
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ('IntersectionObserver' in window && !reduce) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }
</script>