---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalIcon from '../components/LocalIcon.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Lang } from '../scripts/i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;

// 搜索索引同时收录文章与日记：两者内容源独立，仅在搜索这一层合并展示
const blogPosts = (await getCollection('blog'))
  .filter((post) => (post.data.lang ?? 'zh') === lang);
const diaryEntries = (await getCollection('diary'))
  .filter((entry) => (entry.data.lang ?? 'zh') === lang);

type SearchItem = {
  title: string;
  description: string;
  pubDate: Date;
  body: string;
  href: string;
  kind: 'post' | 'diary';
  category: string;
  tags: string[];
};

const items: SearchItem[] = [
  ...blogPosts.map((post): SearchItem => ({
    title: post.data.title,
    description: post.data.description ?? '',
    pubDate: post.data.pubDate,
    body: post.body,
    href: getRelativeLocaleUrl(lang, `/blog/${post.id}`),
    kind: 'post',
    category: post.data.category,
    tags: post.data.tags,
  })),
  ...diaryEntries.map((entry): SearchItem => ({
    title: entry.data.title,
    description: entry.data.description ?? '',
    pubDate: entry.data.pubDate,
    body: entry.body,
    href: getRelativeLocaleUrl(lang, `/diary/${entry.id}`),
    kind: 'diary',
    category: '',
    tags: [],
  })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

function formatDot(date: Date): string {
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${date.getFullYear()}.${m}.${d}`;
}
---

<BaseLayout title="搜索" titleKey="search.title" description="搜索 ArvelVale 的文章与日记">
  <Header />

  <main class="mx-auto w-full max-w-3xl flex-1 px-6">
    <section class="pt-14 md:pt-20">
      <h1 class="font-serif text-4xl font-bold text-ink">{t(lang, 'search.title')}</h1>
      <p class="mt-4 text-[15px] leading-7 text-ink-faint">
        {t(lang, 'search.intro')}
      </p>

      <label
        class="mt-8 flex items-center gap-3 border-b-2 border-line-strong pb-3 transition-colors focus-within:border-ember"
      >
        <LocalIcon name="search" class="h-5 w-5 shrink-0 text-ink-ghost" />
        <input
          id="search-input"
          type="search"
          placeholder={t(lang, 'search.placeholder')}
          class="min-w-0 flex-1 bg-transparent text-lg text-ink outline-none placeholder:text-ink-ghost"
          autocomplete="off"
        />
      </label>
    </section>

    <section class="pb-20 pt-10">
      <p id="search-count" class="font-mono text-[13px] tabular-nums text-ink-ghost">
        {t(lang, 'search.count.all', { n: items.length })}
      </p>

      <ul id="search-results" class="mt-2 divide-y divide-line/70">
        {items.map((item) => {
          const kindLabel = t(lang, item.kind === 'diary' ? 'search.type.diary' : 'search.type.post');
          const searchableText = [
            item.title,
            item.description,
            item.category,
            ...item.tags,
            item.body,
            kindLabel,
          ]
            .filter(Boolean)
            .join(' ')
            .toLowerCase();

          return (
            <li data-search-card data-search={searchableText}>
              <a href={item.href} class="group block py-4 sm:flex sm:items-baseline sm:gap-6">
                <time
                  datetime={item.pubDate.toISOString()}
                  class="block font-mono text-[13px] tabular-nums text-ink-ghost sm:w-[88px] sm:shrink-0"
                >
                  {formatDot(item.pubDate)}
                </time>
                <div class="mt-1 min-w-0 sm:mt-0">
                  <h2 class="text-[17px] font-medium leading-snug text-ink transition-colors group-hover:text-ember">
                    {item.title}
                  </h2>
                  {item.description && (
                    <p class="mt-1 line-clamp-1 text-sm leading-6 text-ink-faint">{item.description}</p>
                  )}
                  <p class="mt-1.5 flex items-center gap-2 text-xs text-ink-ghost">
                    <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[11px] text-ink-faint">{kindLabel}</span>
                    {item.category}
                  </p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>

      <p id="search-empty" class="hidden py-16 text-center text-ink-faint">
        {t(lang, 'search.none')}
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { ct } from '../scripts/i18n';

  const input = document.getElementById('search-input');
  const count = document.getElementById('search-count');
  const empty = document.getElementById('search-empty');
  const cards = Array.from(document.querySelectorAll('[data-search-card]'));

  function normalize(value) {
    return value.trim().toLowerCase();
  }

  function updateSearch() {
    if (!(input instanceof HTMLInputElement)) return;
    const query = normalize(input.value);
    let visibleCount = 0;

    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      const text = card.dataset.search ?? '';
      const visible = !query || text.includes(query);
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    if (count) count.textContent = query
      ? ct('search.count.found', { n: visibleCount })
      : ct('search.count.all', { n: cards.length });
    empty?.classList.toggle('hidden', visibleCount !== 0);
  }

  if (input instanceof HTMLInputElement) {
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q');
    if (initialQuery) input.value = initialQuery;
    input.addEventListener('input', updateSearch);
    updateSearch();
  }
</script>
