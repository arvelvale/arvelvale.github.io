---
// 全站固定背景的粒子星空：星点缓慢漂移并闪烁，近处的星之间连淡线，鼠标移动带一点视差。
// 画布 z-index:-1，落在 body 背景之上、所有内容之下；pointer-events 关闭，不挡点击。
---

<canvas id="starfield" aria-hidden="true" class="pointer-events-none fixed inset-0 h-full w-full" style="z-index:-1"></canvas>

<script>
  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LINK = 120;
    type Star = { x: number; y: number; vx: number; vy: number; r: number; tw: number; ph: number; hue: number; depth: number };
    let stars: Star[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let mx = 0;
    let my = 0;
    let raf = 0;

    const seed = () => {
      // 密度按面积算并封顶，大屏也不会拖慢
      const n = Math.min(140, Math.round((w * h) / 11000));
      stars = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.12,
        vy: (Math.random() - 0.5) * 0.12,
        r: Math.random() * 1.5 + 0.6,
        tw: Math.random() * 0.02 + 0.006,
        ph: Math.random() * Math.PI * 2,
        hue: Math.random() < 0.22 ? 185 : Math.random() < 0.3 ? 235 : 210,
        depth: Math.random() * 0.9 + 0.1,
      }));
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      draw(0);
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      const px = (mx - w / 2) / w;
      const py = (my - h / 2) / h;
      const pts = stars.map((s) => ({
        s,
        x: s.x - px * 22 * s.depth,
        y: s.y - py * 22 * s.depth,
        a: 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t * s.tw + s.ph)),
      }));

      ctx.lineWidth = 0.6;
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const dx = pts[i].x - pts[j].x;
          const dy = pts[i].y - pts[j].y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK * LINK) {
            ctx.strokeStyle = `rgba(120, 200, 235, ${(1 - Math.sqrt(d2) / LINK) * 0.22})`;
            ctx.beginPath();
            ctx.moveTo(pts[i].x, pts[i].y);
            ctx.lineTo(pts[j].x, pts[j].y);
            ctx.stroke();
          }
        }
      }
      for (const p of pts) {
        ctx.fillStyle = `hsla(${p.s.hue}, 90%, 80%, ${p.a})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.s.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const step = (t: number) => {
      for (const s of stars) {
        s.x += s.vx;
        s.y += s.vy;
        if (s.x < -10) s.x = w + 10;
        else if (s.x > w + 10) s.x = -10;
        if (s.y < -10) s.y = h + 10;
        else if (s.y > h + 10) s.y = -10;
      }
      draw(t);
      raf = requestAnimationFrame(step);
    };

    const start = () => {
      if (!reduce && !raf) raf = requestAnimationFrame(step);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    });
    // 标签页不可见时停掉，省电
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    mx = window.innerWidth / 2;
    my = window.innerHeight / 2;
    resize();
    start(); // 减弱动效时只画静态的一帧
  }
</script>
