---
import { t, type Lang } from '../scripts/i18n';
const currentYear = new Date().getFullYear();
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

<footer class="mt-auto border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-6 py-8 text-[13px] text-ink-faint sm:flex-row"
  >
    <p>© {currentYear} ArvelVale</p>
    <p>
      <span>{t(lang, 'footer.built.pre')}</span>
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-ember">Astro</a
      >
      <span>{t(lang, 'footer.built.mid')}</span>
      <a
        href="https://pages.github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-ember">GitHub Pages</a
      >
    </p>
  </div>
</footer>
