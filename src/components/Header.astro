---
import LocalIcon from './LocalIcon.astro';
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页', i18n: 'nav.home', active: currentPath === '/' },
  { href: '/blog', label: '文章', i18n: 'nav.blog', active: currentPath.startsWith('/blog') },
  { href: '/categories', label: '分类', i18n: 'nav.categories', active: currentPath.startsWith('/categories') },
  { href: '/series', label: '专栏', i18n: 'nav.series', active: currentPath.startsWith('/series') },
  { href: '/search', label: '搜索', i18n: 'nav.search', active: currentPath.startsWith('/search') },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href="/"
      class="font-serif text-[22px] font-bold tracking-wide text-ink transition-colors hover:text-ember"
    >
      ArvelVale
    </a>
    <div class="hidden items-center gap-8 text-[15px] md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-i18n={item.i18n}
          class:list={[
            'relative pb-1 transition-colors duration-200',
            item.active
              ? 'font-medium text-ember after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:rounded-full after:bg-ember/70'
              : 'text-ink-faint hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
      <button
        type="button"
        data-lang-toggle
        onclick="window.__setLang(document.documentElement.lang === 'en' ? 'zh' : 'en')"
        aria-label="Switch language / 切换语言"
        class="rounded border border-line px-2 py-0.5 font-mono text-[12px] text-ink-faint transition-colors hover:border-ember/50 hover:text-ember"
      >
        EN
      </button>
      <a
        href="https://github.com/arvelvale"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-ink-faint transition-colors hover:text-ink"
      >
        <LocalIcon name="github" class="h-[18px] w-[18px]" />
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-line text-ink-faint transition-colors hover:text-ink"
      >
        <LocalIcon name="menu" class="h-[18px] w-[18px]" />
      </summary>
      <div
        class="absolute right-0 top-11 w-44 rounded-md border border-line bg-raised p-1.5 text-[15px] shadow-[0_12px_32px_rgba(44,38,32,0.12)]"
      >
        {navItems.map((item) => (
          <a
            href={item.href}
            data-i18n={item.i18n}
            class:list={[
              'block rounded px-3 py-2 transition-colors',
              item.active ? 'bg-ember/5 text-ember' : 'text-ink-soft hover:bg-paper-deep',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a
          href="https://github.com/arvelvale"
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded px-3 py-2 text-ink-soft transition-colors hover:bg-paper-deep"
        >
          GitHub
        </a>
        <button
          type="button"
          data-lang-toggle
          onclick="window.__setLang(document.documentElement.lang === 'en' ? 'zh' : 'en')"
          class="block w-full rounded px-3 py-2 text-left font-mono text-[13px] text-ink-soft transition-colors hover:bg-paper-deep"
        >
          EN
        </button>
      </div>
    </details>
  </nav>
</header>
