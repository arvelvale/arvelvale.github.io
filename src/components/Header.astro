---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LocalIcon from './LocalIcon.astro';
import { t, type Lang } from '../scripts/i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';

// 当前路径剥掉语言前缀，用于 active 判断和语言切换链接
const rawPath = Astro.url.pathname.replace(/^\/(en|zh)(?=\/|$)/, '') || '/';

const navItems = [
  { path: '/', key: 'nav.home', active: rawPath === '/' },
  { path: '/blog', key: 'nav.blog', active: rawPath.startsWith('/blog') },
  { path: '/categories', key: 'nav.categories', active: rawPath.startsWith('/categories') },
  { path: '/projects', key: 'nav.projects', active: rawPath.startsWith('/projects') },
  { path: '/about', key: 'nav.about', active: rawPath.startsWith('/about') },
];

const searchActive = rawPath.startsWith('/search');
const { switchHref: switchHrefOverride } = Astro.props as { switchHref?: string };
const switchHref = switchHrefOverride ?? getRelativeLocaleUrl(otherLang, rawPath === '/' ? '' : rawPath);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a
      href={getRelativeLocaleUrl(lang, '')}
      class="flex items-center gap-2.5 font-serif text-[22px] font-bold tracking-wide text-ink transition-colors hover:text-ember"
    >
      <img src="/avatar.webp" alt="" width="30" height="30" class="h-[30px] w-[30px] rounded-full object-cover ring-1 ring-ember/50" />
      ArvelVale
    </a>
    <div class="hidden items-center gap-8 text-[15px] md:flex">
      {navItems.map((item) => (
        <a
          href={getRelativeLocaleUrl(lang, item.path)}
          class:list={[
            'relative pb-1 transition-colors duration-200',
            item.active
              ? 'font-medium text-ember after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:rounded-full after:bg-ember/70'
              : 'text-ink-faint hover:text-ink',
          ]}
        >
          {t(lang, item.key)}
        </a>
      ))}
      <a
        href={getRelativeLocaleUrl(lang, '/search')}
        aria-label={t(lang, 'nav.search')}
        class:list={['transition-colors', searchActive ? 'text-ember' : 'text-ink-faint hover:text-ink']}
      >
        <LocalIcon name="search" class="h-[18px] w-[18px]" />
      </a>
      <a
        href={switchHref}
        aria-label="Switch language / 切换语言"
        class="rounded border border-line px-2 py-0.5 font-mono text-[12px] text-ink-faint transition-colors hover:border-ember/50 hover:text-ember"
      >
        {otherLang === 'zh' ? '中' : 'EN'}
      </a>
      <a
        href="https://github.com/arvelvale"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-ink-faint transition-colors hover:text-ink"
      >
        <LocalIcon name="github" class="h-[18px] w-[18px]" />
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-line text-ink-faint transition-colors hover:text-ink"
      >
        <LocalIcon name="menu" class="h-[18px] w-[18px]" />
      </summary>
      <div
        class="absolute right-0 top-11 w-44 rounded-md border border-line bg-raised p-1.5 text-[15px] shadow-[0_12px_32px_rgba(0,0,0,0.5)]"
      >
        {navItems.map((item) => (
          <a
            href={getRelativeLocaleUrl(lang, item.path)}
            class:list={[
              'block rounded px-3 py-2 transition-colors',
              item.active ? 'bg-ember/5 text-ember' : 'text-ink-soft hover:bg-paper-deep',
            ]}
          >
            {t(lang, item.key)}
          </a>
        ))}
        <a href={getRelativeLocaleUrl(lang, '/series')} class="block rounded px-3 py-2 text-ink-soft transition-colors hover:bg-paper-deep">{t(lang, 'series.title')}</a>
        <a href={getRelativeLocaleUrl(lang, '/search')} class="block rounded px-3 py-2 text-ink-soft transition-colors hover:bg-paper-deep">{t(lang, 'nav.search')}</a>
        <a
          href="https://github.com/arvelvale"
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded px-3 py-2 text-ink-soft transition-colors hover:bg-paper-deep"
        >
          GitHub
        </a>
        <a
          href={switchHref}
          class="block rounded px-3 py-2 font-mono text-[13px] text-ink-soft transition-colors hover:bg-paper-deep"
        >
          {otherLang === 'zh' ? '中文' : 'English'}
        </a>
      </div>
    </details>
  </nav>
</header>
